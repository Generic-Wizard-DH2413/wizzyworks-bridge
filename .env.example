# Copy this file to .env and configure your settings

# WebSocket Configuration
# Set your WebSocket URI here (required)
WEBSOCKET_URI=wss://your-server-url.com

# Camera Configuration
# 0 is usually the built-in webcam, 1 or higher are for external webcams
CAMERA_INDEX=0

# Common examples:
# For local development:
# WEBSOCKET_URI=ws://localhost:8080/
# 
# For production (default):
# WEBSOCKET_URI=wss://wizzyworks-server.redbush-85e59e10.swedencentral.azurecontainerapps.io